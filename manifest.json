{
  "manifest_version": 3,
  "name": "Jellyfin Video Looper",
  "version": "1.0",
  "description": "Automatically loops all videos on Jellyfin with toggle option",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
